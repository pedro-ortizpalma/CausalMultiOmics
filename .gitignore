# The walkthrough writes beside wherever it was started from, so a run
# launched from tests/manual leaves a nested copy of the whole tree.
tests/manual/output/
**/tests/manual/output/

# The NHANES release the walkthrough runs on: 177 MB, and MainTable.csv alone
# is past the 100 MB file limit GitHub refuses outright. It is published data
# that is not ours to redistribute, and tests/manual/test_data/SOURCE.md says
# where to get it. Everything except the pointer stays out.
tests/manual/test_data/*
!tests/manual/test_data/SOURCE.md

# Base graphics writes this whenever the suite draws without an open device.
Rplots.pdf
/doc/
/Meta/

# Built vignettes land here; the sources in vignettes/ are what is tracked.
doc/
Meta/

# Knitted from the .Rmd beside it, and 1.7 MB. guide-prose.html in the same
# folder is a source file and stays tracked; this one is output, and the
# copy worth keeping lives in docs/ where Pages can serve it.
dev/analisis-ejemplo.html
.Rproj.user
.Rproj.user
docs/


# testthat >= 3.3 writes a reproduction script here when a test fails.
tests/testthat/_problems/
